# Design Cloud Engine — systemd unit (packaged)
#
# Role is NOT chosen at install time. Every node installs the same package and
# the same unit. Hostname in cluster.servers decides whether Server role is enabled;
# Agent role runs unconditionally on all nodes. Configless agents override ExecStart via `systemctl edit` (see
# /usr/share/doc/design-cloud-engine/systemd/configless.conf.example).
#
# Do NOT enable this unit from RPM %post — edit /etc/design-cloud/config.toml
# (and secret files) first, then: systemctl enable --now design-cloud-engine

[Unit]
Description=Design Cloud Engine
Documentation=file:///usr/share/doc/design-cloud-engine/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=design-cloud
Group=design-cloud

# FHS roots (systemd ≥219 ignores unknown keys; CentOS 7 relies on ReadWritePaths + tmpfiles)
ConfigurationDirectory=design-cloud
StateDirectory=design-cloud
LogsDirectory=design-cloud
RuntimeDirectory=design-cloud
RuntimeDirectoryMode=0700
Environment=RUNTIME_DIRECTORY=/run/design-cloud

WorkingDirectory=/opt/design-cloud

# Fail fast on bad/incomplete config before the main process starts
ExecStartPre=/opt/design-cloud/design-cloud-engine check-config --config /etc/design-cloud/config.toml
ExecStart=/opt/design-cloud/design-cloud-engine --config /etc/design-cloud/config.toml --log-dir /var/log/design-cloud

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StartLimitIntervalSec=60
StartLimitBurst=5

# Optional: bind privileged ports without root (ignored if unused)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening (ProtectSystem=strict needs systemd ≥232; CentOS 7/219 silently ignores)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/design-cloud /var/lib/design-cloud /var/log/design-cloud /run/design-cloud

LimitNOFILE=65536
LimitNPROC=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=design-cloud-engine

[Install]
WantedBy=multi-user.target
