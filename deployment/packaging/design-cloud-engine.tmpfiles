# tmpfiles.d — recreate runtime/state dirs (tmpfs /run; durable /var /etc)
# Type Path Mode UID GID Age Argument
# UID/GID placeholders filled by build-packages.sh (__PKG_USER__/__PKG_GROUP__)
#
# Cluster mTLS layout is created up front (not only at node register / issue-cert):
#   certs/cluster 0755 (shared traverse for ca.crt)
#   certs/cluster/ca 0700 (CA private key dir)
# Per-node <hostname>/ dirs stay 0700 and are still created when materials land.
d /run/design-cloud 0700 __PKG_USER__ __PKG_GROUP__ - -
d /var/log/design-cloud 0750 __PKG_USER__ __PKG_GROUP__ - -
d /var/lib/design-cloud 0700 __PKG_USER__ __PKG_GROUP__ - -
d /var/lib/design-cloud/certs 0755 __PKG_USER__ __PKG_GROUP__ - -
d /var/lib/design-cloud/certs/cluster 0755 __PKG_USER__ __PKG_GROUP__ - -
d /var/lib/design-cloud/certs/cluster/ca 0700 __PKG_USER__ __PKG_GROUP__ - -
d /var/lib/design-cloud/data 0750 __PKG_USER__ __PKG_GROUP__ - -
d /var/lib/design-cloud/data/desktop 0750 __PKG_USER__ __PKG_GROUP__ - -
d /var/lib/design-cloud/data/desktop/plugins 0750 __PKG_USER__ __PKG_GROUP__ - -
d /etc/design-cloud 0750 __PKG_USER__ __PKG_GROUP__ - -
d /etc/design-cloud/certs 0750 __PKG_USER__ __PKG_GROUP__ - -
d /etc/design-cloud/certs/portal 0750 __PKG_USER__ __PKG_GROUP__ - -
