{
  "version": "2.0.0",
  "options": {
    "env": {
      "CGO_ENABLED": "0"
    }
  },
  "tasks": [
    {
      "label": "go: test all",
      "type": "shell",
      "command": "go",
      "args": [
        "test",
        "-v",
        "./..."
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "run: engine",
      "detail": "本地 make run（config.dev.toml）",
      "type": "shell",
      "command": "make",
      "args": [
        "run"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "remote: push",
      "detail": "本地编译 dc-exec+engine → 上传安装 /opt/dce → dlv 启动 engine（hpcadmin）",
      "type": "shell",
      "command": "bash",
      "args": [
        ".vscode/remote.sh",
        "push"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "remote: build",
      "detail": "rsync 源码 → 远程编译 → 安装 /opt/dce → dlv 启动 engine（hpcadmin）",
      "type": "shell",
      "command": "bash",
      "args": [
        ".vscode/remote.sh",
        "build"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "cleanup: remote",
      "detail": "停远程 dlv/engine + 清本地隧道",
      "type": "shell",
      "command": "bash",
      "args": [
        ".vscode/remote.sh",
        "cleanup"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "remote: portal api test",
      "detail": "remote: build → 全量 Portal HTTP 测试（dev-ldap-hpcadmin）",
      "type": "shell",
      "command": "bash",
      "args": [
        "test/portal/run.sh"
      ],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "remote: portal api test (no build)",
      "detail": "仅跑 HTTP 测试（假定 remote: build 已就绪）",
      "type": "shell",
      "command": "bash",
      "args": [
        "test/portal/run.sh",
        "--no-build"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "check: remote status",
      "detail": "本地隧道 / 远程 dlv / 端口 / API / dc-exec 权限",
      "type": "shell",
      "command": "bash",
      "args": [
        ".vscode/remote.sh",
        "status"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
