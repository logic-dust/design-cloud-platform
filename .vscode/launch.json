{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local Engine",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/engine",
      "env": {
        "CGO_ENABLED": "0",
        "CONFIG_FILE": "${workspaceFolder}/config.dev.toml"
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "logOutput": "rpc",
      "showLog": true,
      "trace": "verbose"
    },
    {
      "name": "Remote Engine (Debug & Attach)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "${config:remoteDebug.host}",
      "showLog": true,
      "trace": "verbose",
      "logOutput": "rpc",
      "preLaunchTask": "remote-debug",
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "design-cloud-engine"
        }
      ]
    },
    {
      "name": "Remote Build Engine (Debug & Attach)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "${config:remoteDebug.host}",
      "showLog": true,
      "trace": "verbose",
      "logOutput": "rpc",
      "preLaunchTask": "remote-build-debug",
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "design-cloud-engine"
        }
      ]
    },
    {
      "name": "Connect Tunnel Engine",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "127.0.0.1",
      "showLog": true,
      "trace": "verbose",
      "logOutput": "rpc",
      "preLaunchTask": "create-tunnel",
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "design-cloud-engine"
        }
      ]
    },
    {
      "name": "Connect Direct Engine",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "${config:remoteDebug.host}",
      "showLog": true,
      "trace": "verbose",
      "logOutput": "rpc",
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "design-cloud-engine"
        }
      ]
    },
    {
      "name": "Test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "env": {
        "CGO_ENABLED": "0"
      },
      "args": [
        "-test.v",
        "-test.run",
        ".*"
      ],
      "cwd": "${workspaceFolder}",
      "showLog": true
    }
  ]
}