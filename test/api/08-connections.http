### 获取连接详情
GET {{addr}}/api/connections/{{testConnectionId}}
Authorization: Bearer {{accessToken}}

### 刷新当前用户连接状态
POST {{addr}}/api/connections/refresh
Authorization: Bearer {{accessToken}}

### 删除单个连接
DELETE {{addr}}/api/connections/{{testVNCConnectionId}}
Authorization: Bearer {{accessToken}}


### 批量删除连接
POST {{addr}}/api/connections/batch-delete
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "ids": [
    "{{testBatchConnectionId}}"
  ]
}

### 用户删除 Fixed 连接应被拒绝 (403)
# 需先执行 08-system-connections.http 由管理员创建 Fixed 连接并记录 testFixedConnectionId
DELETE {{addr}}/api/connections/{{testFixedConnectionId}}
Authorization: Bearer {{accessToken}}

> {%
  if (response.status !== 403) {
    throw new Error(`Expected 403 for user deleting fixed connection, got ${response.status}`);
  }
  client.log('Verified: user cannot delete fixed connection');
%}

### 用户启动 Fixed VNC 连接 (需要环境有真实 vncserver)
POST {{addr}}/api/connections/{{testFixedConnectionId}}/start
Authorization: Bearer {{accessToken}}

### 用户停止 Fixed VNC 连接 (需要环境有真实 vncserver)
POST {{addr}}/api/connections/{{testFixedConnectionId}}/stop
Authorization: Bearer {{accessToken}}

### 用户重启 Fixed VNC 连接 (需要环境有真实 vncserver)
POST {{addr}}/api/connections/{{testFixedConnectionId}}/restart
Authorization: Bearer {{accessToken}}
