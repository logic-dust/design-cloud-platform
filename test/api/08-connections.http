# ========================================
# ===== CONNECTIONS Http =====
# ========================================
# ----- 先执行 02-session.http 登录 -----



### 获取当前用户连接列表
GET {{addr}}/api/connections
Authorization: Bearer {{accessToken}}

> {%



if (response.status !== 200) {
  throw new Error(`Expected 200 for user connection list, got ${response.status}`);
}
const connections = response.body?.data;
if (!Array.isArray(connections)) {
  throw new Error("Expected connection list response data to be an array");
}
client.log(`Verified: user connection list contains ${connections.length} current-user connections`);



%}

### 获取VNC OTP密码
POST {{addr}}/api/connections/1/vnc-otp
Authorization: Bearer {{accessToken}}

> {%



  if (response.status !== 400) {
    throw new Error(`Expected 400 for manual VNC OTP request, got ${response.status}`);
  }
  client.log('Verified: manual VNC connection cannot generate TurboVNC OTP');



%}


### 创建手工连接VNC
POST {{addr}}/api/connections
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "alias": "manual-vnc",
  "protocol": "VNC",
  "host": "{{host}}",
  "port": 5901
}

> {%


const payload = response.body;
if (payload?.data?.id) {
  client.global.set("testVNCConnectionId", String(payload.data.id));
  client.global.set("testConnectionId", String(payload.data.id));
  client.global.set("testVNCConnectionPayload", JSON.stringify(payload.data));
  client.log(`Stored testVNCConnectionId=${payload.data.id}`);
  client.log(`Stored testConnectionId=${payload.data.id}`);
}


%}

### 创建手工连接SSH
POST {{addr}}/api/connections
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "alias": "manual-ssh",
  "protocol": "SSH",
  "host": "{{host}}",
  "port": 22
}

> {%


const payload = response.body;
if (payload?.data?.id) {
  client.global.set("testBatchConnectionId", String(payload.data.id));
  client.log(`Stored testBatchConnectionId=${payload.data.id}`);
}


%}


