# ========================================
# ===== PROXY Http =====
# ========================================
# ----- 先执行 02-session.http 登录 -----
# ----- 需要先创建连接并获取 testVNCConnectionId（参见 08-connections.http） -----

### 创建代理会话
POST {{addr}}/api/connections/{{testVNCConnectionId}}/proxy-session
Authorization: Bearer {{accessToken}}

> {%



const payload = response.body;
if (payload?.data?.otp) {
  client.global.set("testProxySessionOtp", String(payload.data.otp));
  client.log(`Stored testProxySessionOtp=${payload.data.otp}`);
}
if (payload?.data?.connectionId) {
  client.log(`Proxy session created for connectionId=${payload.data.connectionId}`);
}



%}

### 获取代理会话
GET {{addr}}/api/connections/{{testVNCConnectionId}}/proxy-session
Authorization: Bearer {{accessToken}}

> {%



const payload = response.body;
if (payload?.data?.otp) {
  throw new Error("GET proxy-session should not return otp");
}



%}

### 删除代理会话
DELETE {{addr}}/api/connections/{{testVNCConnectionId}}/proxy-session
Authorization: Bearer {{accessToken}}


