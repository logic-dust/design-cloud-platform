# ========================================
# ===== SYSTEM-APPS Http =====
# ========================================
# ----- 先执行 02-session.http 登录（需要 System Admin 权限） -----

### 创建应用（写入 testAppId）
POST {{addr}}/api/admin/system/apps
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "test_app",
  "alias": "Test Application",
  "type": "GUI",
  "protocol": "VNC",
  "mode": "desktop",
  "cmd": "/usr/bin/xterm",
  "public": true
}

> {%



const payload = response.body;
if (payload?.data?.id) {
  client.global.set("testAppId", String(payload.data.id));
  client.log(`Stored testAppId=${payload.data.id}`);
}



%}

### 获取所有应用
GET {{addr}}/api/admin/system/apps
Authorization: Bearer {{accessToken}}

### 获取单个应用详情 (Admin only)
GET {{addr}}/api/admin/system/apps/{{testAppId}}
Authorization: Bearer {{accessToken}}

### 更新应用
PUT {{addr}}/api/admin/system/apps/{{testAppId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "updated_app1",
  "alias": "Updated Alias",
  "type": "GUI",
  "protocol": "VNC",
  "mode": "desktop",
  "cmd": "/usr/bin/xterm",
  "public": true
}

### 查看应用关联用户
GET {{addr}}/api/admin/system/apps/{{testAppId}}/users
Authorization: Bearer {{accessToken}}

### 替换应用关联用户列表
PUT {{addr}}/api/admin/system/apps/{{testAppId}}/users
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "users": [
    "{{username}}"
  ]
}

### 增量移除应用用户关联 (Admin only)
PATCH {{addr}}/api/admin/system/apps/{{testAppId}}/users
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "remove": [
    "{{normalUser}}"
  ]
}

### 删除应用 (Admin only)
DELETE {{addr}}/api/admin/system/apps/{{testAppId}}
Authorization: Bearer {{accessToken}}
