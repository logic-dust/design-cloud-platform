# ========================================
# ===== ADMIN-CONNECTIONS Http =====
# ========================================
# ----- 先执行 02-session.http 登录（需要 System Admin 权限） -----
# ----- 需先执行 08-connections.http 创建连接获取 testVNCConnectionId 等变量 -----

### 管理员获取所有连接 (Admin only)
GET {{addr}}/api/admin/system/connections
Authorization: Bearer {{accessToken}}

### 管理员获取连接详情 (Admin only)
GET {{addr}}/api/admin/system/connections/{{testVNCConnectionId}}
Authorization: Bearer {{accessToken}}

### 触发全局连接刷新 (Admin only)
POST {{addr}}/api/admin/system/connections/refresh
Authorization: Bearer {{accessToken}}

### 管理员执行连接清理 (Admin only)
POST {{addr}}/api/admin/system/connections/cleanup
Authorization: Bearer {{accessToken}}

### 管理员批量删除连接 (Admin only)
POST {{addr}}/api/admin/system/connections/batch-delete
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "ids": [
    "{{testAdminBatchConnectionId}}"
  ]
}

### 管理员删除单个连接 (Admin only)
DELETE {{addr}}/api/admin/system/connections/{{testAdminConnectionId}}
Authorization: Bearer {{accessToken}}

### 管理员创建 Fixed 连接 (Admin only)
POST {{addr}}/api/admin/system/connections
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "fixed-test-cn01-11",
  "username": "{{username}}",
  "targetNodeId": "{{testNode}}",
  "host": "192.168.1.10",
  "protocol": "VNC",
  "port": 5911,
  "display": ":11"
}

> {%
  const payload = response.body;
  if (payload?.data?.id) {
    client.global.set("testFixedConnectionId", String(payload.data.id));
    client.log(`Stored testFixedConnectionId=${payload.data.id}`);
  } else {
    throw new Error("Expected fixed connection creation to return data.id");
  }
%}

### 管理员启动 Fixed VNC 连接 (Admin only)
POST {{addr}}/api/admin/system/connections/{{testFixedConnectionId}}/start
Authorization: Bearer {{accessToken}}

### 管理员停止 Fixed VNC 连接 (Admin only)
POST {{addr}}/api/admin/system/connections/{{testFixedConnectionId}}/stop
Authorization: Bearer {{accessToken}}

### 管理员重启 Fixed VNC 连接 (Admin only)
POST {{addr}}/api/admin/system/connections/{{testFixedConnectionId}}/restart
Authorization: Bearer {{accessToken}}

### 管理员生成 VNC OTP (Admin only)
POST {{addr}}/api/admin/system/connections/{{testFixedConnectionId}}/vnc-otp
Authorization: Bearer {{accessToken}}

### 管理员删除 Fixed 连接 (Admin only)
DELETE {{addr}}/api/admin/system/connections/{{testFixedConnectionId}}
Authorization: Bearer {{accessToken}}

### 管理员创建共享 Fixed RDP 连接 (Admin only)
# shared=true：所有用户可见可连，username 留空
POST {{addr}}/api/admin/system/connections
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "shared-win-server-01",
  "shared": true,
  "targetNodeId": "{{testNode}}",
  "host": "10.0.0.5",
  "protocol": "RDP",
  "port": 3389
}

> {%
  const payload = response.body;
  if (payload?.data?.id) {
    client.global.set("testSharedConnectionId", String(payload.data.id));
    client.log(`Stored testSharedConnectionId=${payload.data.id}`);
  } else {
    throw new Error("Expected shared connection creation to return data.id");
  }
%}

### 管理员删除共享 Fixed 连接 (Admin only)
DELETE {{addr}}/api/admin/system/connections/{{testSharedConnectionId}}
Authorization: Bearer {{accessToken}}

### 管理员批量 Upsert 固定连接 (Admin only)
# 幂等写入/更新固定连接列表（host 可由节点自动填充，protocol 默认为 VNC）
PUT {{addr}}/api/admin/system/connections/batch-upsert
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "records": [
    {
      "username": "{{username}}",
      "targetNodeId": "{{testNode}}",
      "port": 5912,
      "display": ":12"
    }
  ]
}

