# ========================================
# ===== TICKETS Http =====
# ========================================
# ----- 先执行 02-session.http 登录 -----
# ----- 需要先执行 21-tickets-systemadmin.http 中的"创建项目"获取 testProjectId -----


### 获取项目列表
GET {{addr}}/api/tickets/projects
Authorization: Bearer {{accessToken}}

# ========================================
# ===== 普通用户 API =====
# ========================================

### 创建工单
POST {{addr}}/api/tickets
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "projectId": {{testProjectId}},
  "type": 0,
  "title": "修复登录页面 UI 错位",
  "description": "在小屏幕上登录按钮位置错位",
  "assigneeId": 2,
  "priority": 2,
  "status": 0,
  "acceptanceCriteria": {
    "description": "按钮在各种分辨率下应正确显示",
    "checklist": [
      "800x600 分辨率居中显示",
      "移动端适配正常",
      "支持 Chrome/Firefox/Safari"
    ]
  }
}

> {%



const payload = response.body;
if (payload?.data?.id) {
  client.global.set("testTicketId", String(payload.data.id));
  client.log(`Stored testTicketId=${payload.data.id}`);
}



%}

### 获取工单列表
GET {{addr}}/api/tickets?projectId={{testProjectId}}&status=0&limit=20&offset=0
Authorization: Bearer {{accessToken}}

### 获取工单详情
GET {{addr}}/api/tickets/{{testTicketId}}
Authorization: Bearer {{accessToken}}

### 更新工单（看板拖拽）
PATCH {{addr}}/api/tickets/{{testTicketId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": 1,
  "sortOrder": 1500.0
}

### 获取用户列表
GET {{addr}}/api/tickets/users
Authorization: Bearer {{accessToken}}

### 获取统计概览
GET {{addr}}/api/tickets/summary?projectId={{testProjectId}}
Authorization: Bearer {{accessToken}}

### 批量删除工单
POST {{addr}}/api/tickets/batch-delete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "ids": ["{{testTicketId}}"]
}

### 删除工单
DELETE {{addr}}/api/tickets/{{testTicketId}}
Authorization: Bearer {{accessToken}}

# ----------------------------------------------------------------------
# ----- 提示：管理员操作（项目更新/归档/删除，工单软删/硬删）请参见 21-tickets-systemadmin.http -----
# ----------------------------------------------------------------------

