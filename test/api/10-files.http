# ========================================
# ===== FILES Http =====
# ========================================
# ----- 先执行 02-session.http 登录 -----


### 列出可用文件位置
GET {{addr}}/api/files/locations
Authorization: Bearer {{accessToken}}

### 列出预定义目录 HOME
GET {{addr}}/api/files/locations/home/contents
Authorization: Bearer {{accessToken}}

### 列出HOME下相对路径.config
GET {{addr}}/api/files/locations/home/contents/.config
Authorization: Bearer {{accessToken}}

### 列出预定义目录 Public
GET {{addr}}/api/files/locations/public/contents
Authorization: Bearer {{accessToken}}

### 上传文件upload.txt到预定义目录HOME中
PUT {{addr}}/api/files/locations/home/contents/upload.txt
Authorization: Bearer {{accessToken}}
Content-Type: text/plain

hello world


### 创建一次性下载 Token（downloadAccess=allow）
POST {{addr}}/api/files/download-tokens
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "location": "home",
  "path": "upload.txt"
}

> {%



const payload = response.body;
if (payload?.data?.token) {
  client.global.set("testFileDownloadToken", String(payload.data.token));
}




%}

### 直接下载模式：凭 Token 下载(upload.txt，凭证成功校验后即核销)
GET {{addr}}/api/files/downloads/{{testFileDownloadToken}}
Authorization: Bearer {{accessToken}}

### 审批下载模式：创建下载审批申请（downloadAccess=request）
POST {{addr}}/api/files/download-requests
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "location": "home",
  "path": "upload.txt"
}

> {%



const payload = response.body;
if (payload?.data?.downloadRequestId) {
  client.global.set("testFileDownloadRequestId", String(payload.data.downloadRequestId));
}



%}

### 查看我的下载申请
GET {{addr}}/api/files/download-requests
Authorization: Bearer {{accessToken}}

### 查看我的下载申请详情
GET {{addr}}/api/files/download-requests/{{testFileDownloadRequestId}}
Authorization: Bearer {{accessToken}}

# ----- 提示：审批操作（同意/拒绝下载申请）请参见 10-files-securityadmin.http -----

### 审批通过后，用申请换一次性下载 Token
POST {{addr}}/api/files/download-requests/{{testFileDownloadRequestId}}/tokens
Authorization: Bearer {{accessToken}}

> {%




const payload = response.body;
if (payload?.data?.token) {
  client.global.set("testFileDownloadToken", String(payload.data.token));
  client.log(`Stored testFileDownloadToken=${payload.data.token}`);
} else {
  client.global.set("testFileDownloadToken", "__missing_token__");
}




%}

### 审批下载模式：凭 Token 下载(upload.txt，凭证成功校验后即核销)
GET {{addr}}/api/files/downloads/{{testFileDownloadToken}}
Authorization: Bearer {{accessToken}}

### 创建目录old_dir
POST {{addr}}/api/files/locations/home/contents
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "old_dir"
}

### 创建目录old_dir/sub_dir用于测试
POST {{addr}}/api/files/locations/home/contents
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "path": "old_dir",
  "name": "sub_dir"
}

### 重命名文件 将 用户目录下的old_dir重命名为new_dir
POST {{addr}}/api/files/locations/home/contents/rename
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "path": "old_dir",
  "name": "new_dir"
}

### 删除文件（上传的文件upload.txt)
POST {{addr}}/api/files/locations/home/contents/batch-delete
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "paths": [
    "upload.txt"
  ]
}

### 移至回收站（用户目录下的new_dir)
POST {{addr}}/api/files/trash/items
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "location": "home",
  "paths": [
    "new_dir"
  ]
}

### 列出回收站项目
GET {{addr}}/api/files/trash/contents
Authorization: Bearer {{accessToken}}

### 列出回收站子目录（new_dir)
GET {{addr}}/api/files/trash/contents/new_dir
Authorization: Bearer {{accessToken}}

### 删除回收站单个项目（new_dir)
DELETE {{addr}}/api/files/trash/items/new_dir
Authorization: Bearer {{accessToken}}

### 批量删除回收站项目
POST {{addr}}/api/files/trash/items/batch-delete
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "names": [
    "1",
    "2"
  ]
}

### 清空回收站
DELETE {{addr}}/api/files/trash/items
Authorization: Bearer {{accessToken}}


