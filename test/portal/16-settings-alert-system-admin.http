# ========================================
# ===== ALERT-SETTINGS Http =====
# ========================================
# ----- 先执行 02-session.http 登录（需要 System Admin 权限） -----

### 按领域获取告警配置（默认配置）
GET {{addr}}/api/admin/system/settings/alert
Authorization: Bearer {{accessToken}}

### 全量更新告警配置（合法）
PUT {{addr}}/api/admin/system/settings/alert
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "enabled": true,
  "cpu": {
    "enabled": false,
    "maxUsedPercent": 0,
    "cooldownInterval": 300
  },
  "load": {
    "enabled": false,
    "maxLoadPercent": 110,
    "cooldownInterval": 300
  },
  "memory": {
    "enabled": true,
    "maxUsedPercent": 85,
    "minFreeSpace": 52428800,
    "cooldownInterval": 300
  },
  "disk": {
    "enabled": true,
    "maxUsedPercent": 90,
    "minFreeSpace": 0,
    "cooldownInterval": 300
  },
  "sharedStorage": {
    "enabled": true,
    "maxUsedPercent": 90,
    "minFreeSpace": 0,
    "cooldownInterval": 1800
  }
}

### 全量更新告警配置（非法：memory.maxUsedPercent=101 → 422）
PUT {{addr}}/api/admin/system/settings/alert
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "enabled": true,
  "cpu": {
    "enabled": false,
    "maxUsedPercent": 0,
    "cooldownInterval": 300
  },
  "load": {
    "enabled": false,
    "maxLoadPercent": 110,
    "cooldownInterval": 300
  },
  "memory": {
    "enabled": true,
    "maxUsedPercent": 101,
    "cooldownInterval": 300
  },
  "disk": {
    "enabled": true,
    "maxUsedPercent": 90,
    "minFreeSpace": 0,
    "cooldownInterval": 300
  },
  "sharedStorage": {
    "enabled": true,
    "maxUsedPercent": 90,
    "minFreeSpace": 0,
    "cooldownInterval": 1800
  }
}

### 全量更新告警配置（非法：sharedStorage 启用但两个阈值均为 0 → 422）
PUT {{addr}}/api/admin/system/settings/alert
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "enabled": true,
  "cpu": {
    "enabled": false,
    "maxUsedPercent": 0,
    "cooldownInterval": 300
  },
  "load": {
    "enabled": false,
    "maxLoadPercent": 110,
    "cooldownInterval": 300
  },
  "memory": {
    "enabled": true,
    "maxUsedPercent": 85,
    "cooldownInterval": 300
  },
  "disk": {
    "enabled": true,
    "maxUsedPercent": 90,
    "minFreeSpace": 0,
    "cooldownInterval": 300
  },
  "sharedStorage": {
    "enabled": true,
    "maxUsedPercent": 0,
    "minFreeSpace": 0,
    "cooldownInterval": 1800
  }
}

### 负向用例：更新告警配置越界（load.maxLoadPercent > 200 → 422）
PUT {{addr}}/api/admin/system/settings/alert
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "load": {
    "enabled": false,
    "maxLoadPercent": 201,
    "cooldownInterval": 300
  }
}

> {%
client.test("load.maxLoadPercent above max returns 422", function() {
  client.assert(response.status === 422, "Response status is 422 Unprocessable Entity");
});
%}

### 获取告警配置域的 JSON Schema
GET {{addr}}/api/admin/system/settings/alert/schema
Authorization: Bearer {{accessToken}}

### 获取告警历史记录
GET {{addr}}/api/admin/system/alerts/history?limit=100
Authorization: Bearer {{accessToken}}

