# ========================================
# ===== SSE PUSH Http =====
# ========================================
# ----- 先执行 02-session.http 登录 -----
# ----- 长连接流式接口：REST Client 只能验证握手/首帧，完整流式用 curl 手测（见文件末尾） -----

# @expect 200
### 全局通知流握手（PolicySSE 链，无 60s 超时）
GET {{addr}}/api/events
Authorization: Bearer {{accessToken}}

# @expect 200
### Overview 集群流握手（建连即推第一帧快照）
GET {{addr}}/api/overview/cluster/stream
Authorization: Bearer {{accessToken}}

# @expect 200,401,404
### Overview 集群流（大屏 Guest Token，全集群作业统计）
GET {{addr}}/api/overview/cluster/stream?token=__dc_public_overview_guest_token__

# @expect 200
### Overview 个人流（当前用户作业统计）
GET {{addr}}/api/overview/me/stream
Authorization: Bearer {{accessToken}}

# @expect 200
### 审计日志流握手（Audit admin）
GET {{addr}}/api/admin/audit/logs/audit/stream
Authorization: Bearer {{accessToken}}

# ----------------------------------------------------------------------
# ----- curl 手测命令（完整流式验证，REST Client 无法覆盖长连接） -----
# ----------------------------------------------------------------------
#
# 1. 全局流：15s 心跳 + 70s 不断（验证 60s 超时豁免生效）
#    TOKEN=<登录 token>
#    curl -N --no-buffer -H "Authorization: Bearer $TOKEN" -m 70 http://localhost:1234/api/events
#
# 2. Overview 集群流：立即 + 30s 各一帧快照
#    curl -N --no-buffer -H "Authorization: Bearer $TOKEN" -m 35 "http://localhost:1234/api/overview/cluster/stream"
#
# 3. 审计日志流（从文件末尾 tail-follow）
#    curl -N --no-buffer -H "Authorization: Bearer $TOKEN" -m 5 "http://localhost:1234/api/admin/audit/logs/audit/stream"
#
# 4. 工单事件推送联动验证：
#    终端 A：curl -N --no-buffer -H "Authorization: Bearer $TOKEN" -m 60 http://localhost:1234/api/events
#    终端 B：curl -X POST http://localhost:1234/api/tickets -H "Authorization: Bearer $TOKEN" \
#            -H "Content-Type: application/json" -d '{"projectId":<projectId>,"type":"task","title":"SSE 联动测试","priority":"medium","status":"todo","assigneeId":<userId>}'
#    终端 A 应收到 event: ticket / data: {"action":"refresh"}

