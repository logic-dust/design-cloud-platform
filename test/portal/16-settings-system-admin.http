### 全量更新 License 配置
PUT {{addr}}/api/admin/system/settings/license
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "statusCacheTTL": 60,
  "featuresCacheTTL": 60,
  "lmutilPath": "/opt/flexnet/bin/lmutil"
}

### 负向用例：更新 License 配置越界（statusCacheTTL < 60，断言 422）
PUT {{addr}}/api/admin/system/settings/license
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "statusCacheTTL": 10,
  "featuresCacheTTL": 60,
  "lmutilPath": "/opt/flexnet/bin/lmutil"
}

> {%
client.test("StatusCacheTTL below min returns 422", function() {
  client.assert(response.status === 422, "Response status is 422 Unprocessable Entity");
});
%}

### 局部更新 Scheduler 配置（保持默认调度器类型，设置环境脚本为空）
PUT {{addr}}/api/admin/system/settings/scheduler
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "type": "lsf"
}

> {%
client.test("Scheduler settings update returns 204", function() {
  client.assert(response.status === 204, "Response status is 204 No Content");
});
%}

### 负向用例：更新 Scheduler 配置使用未知调度器类型（断言 422）
PUT {{addr}}/api/admin/system/settings/scheduler
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "type": "pbs"
}

> {%
client.test("Unknown scheduler type returns 422", function() {
  client.assert(response.status === 422, "Response status is 422 Unprocessable Entity");
});
%}

### 负向用例：Scheduler 环境脚本必须为绝对路径（断言 422）
PUT {{addr}}/api/admin/system/settings/scheduler
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "type": "lsf",
  "envScript": "conf/profile.lsf"
}

> {%
client.test("Relative scheduler envScript returns 422", function() {
  client.assert(response.status === 422, "Response status is 422 Unprocessable Entity");
});
%}
