# Content-Type: application/json
# Authorization: Bearer {{accessToken}}
#
# {
#   "location": "shared-data",
#   "path": "example.txt"
# }

# PUT {{addr}}/api/files/locations/shared-data/contents/should-not-upload.txt
# Authorization: Bearer {{accessToken}}
# Content-Type: text/plain
#
# should be rejected
