# ========================================
# ===== SYSTEM USERS Http =====
# ========================================
# ----- 先执行 02-session.http 登录 -----
# ----- 用户管理在 /api/admin/system/users 下（System Admin） -----

### 获取所有用户 (System admin)
GET {{addr}}/api/admin/system/users?limit=50&offset=0
Authorization: Bearer {{accessToken}}

### 按 type=system 过滤（连接授权选人） (System admin)
GET {{addr}}/api/admin/system/users?limit=50&offset=0&type=system
Authorization: Bearer {{accessToken}}

### 按 type+status 过滤 (System admin)
GET {{addr}}/api/admin/system/users?limit=50&offset=0&type=system&status=active
Authorization: Bearer {{accessToken}}

### 按用户名子串搜索 (System admin)
GET {{addr}}/api/admin/system/users?limit=50&offset=0&q={{username}}
Authorization: Bearer {{accessToken}}

### 搜索无结果 (System admin)
GET {{addr}}/api/admin/system/users?limit=50&offset=0&q=__no_such_user__
Authorization: Bearer {{accessToken}}

### 获取单个用户详情 (System admin)
GET {{addr}}/api/admin/system/users/{{username}}
Authorization: Bearer {{accessToken}}

### 获取用户所属目录组 (System admin)
GET {{addr}}/api/admin/system/users/{{username}}/groups
Authorization: Bearer {{accessToken}}

### 同步系统/LDAP用户 (System admin)
POST {{addr}}/api/admin/system/users/sync
Authorization: Bearer {{accessToken}}

### 更新用户记录 (System admin)
PATCH {{addr}}/api/admin/system/users/{{username}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "status": 1,
  "maxConnections": 10,
  "downloadDisabled": false,
  "uploadDisabled": false
}

# @manual
### 重置用户密码 (System admin)
POST {{addr}}/api/admin/system/users/{{normalUser}}/reset-password
Authorization: Bearer {{accessToken}}

# @manual
### 删除门户用户 (System admin)
# ----- 204：已关闭代理、结束 VNC，并删除该用户的 connections -----
# ----- 404：用户不存在 -----
DELETE {{addr}}/api/admin/system/users/{{normalUser}}
Authorization: Bearer {{accessToken}}
