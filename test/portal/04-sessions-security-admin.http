# ========================================
# ===== SECURITY SESSIONS Http =====
# ========================================
# ----- 先执行 02-session.http 登录 -----

### 获取所有认证会话 (Security admin)
GET {{addr}}/api/admin/security/sessions?limit=50&offset=0
Authorization: Bearer {{accessToken}}

### 踢出指定会话 (Security admin)
DELETE {{addr}}/api/admin/security/sessions/1
Authorization: Bearer {{accessToken}}

### 批量踢出会话 (Security admin)
POST {{addr}}/api/admin/security/sessions/batch-delete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "ids": ["1", "2"]
}

### 踢出指定用户的所有会话 (Security admin)
DELETE {{addr}}/api/admin/security/sessions?username={{normalUser}}
Authorization: Bearer {{accessToken}}
