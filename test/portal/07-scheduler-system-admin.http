# ========================================
# ===== SYSTEM-SCHEDULER Http =====
# ========================================
# ----- 先执行 02-session.http 登录（需要 System Admin 权限） -----
# ----- 需先执行 07-scheduler.http 获取 testJobId -----

### 管理员获取调度器静态元数据（推荐列、核心字段映射、状态动作集合）
GET {{addr}}/api/admin/system/scheduler/meta
Authorization: Bearer {{accessToken}}

> {%
const payload = response.body;
const meta = payload?.data;
client.test("admin meta returns scheduler schema", function() {
  client.assert(response.status === 200, "status is 200");
  client.assert(typeof meta?.scheduler === "string" && meta.scheduler.length > 0, "scheduler is present");
  client.assert(Array.isArray(meta?.fields) && meta.fields.length > 0, "fields is non-empty array");
  client.assert(typeof meta?.keys?.id === "string" && meta.keys.id.length > 0, "keys.id is present");
  client.assert(typeof meta?.actions === "object" && meta.actions !== null, "actions is present");
});
%}

# @probe
### 管理员获取 HPC 计算主机列表
GET {{addr}}/api/admin/system/scheduler/hosts
Authorization: Bearer {{accessToken}}

### 管理员获取 HPC 队列作业数汇总
GET {{addr}}/api/admin/system/scheduler/queues
Authorization: Bearer {{accessToken}}

### 管理员获取全集群任务列表
GET {{addr}}/api/admin/system/scheduler/jobs
Authorization: Bearer {{accessToken}}

# @manual
### 管理员按用户/队列/节点过滤任务列表（依赖 LSF，仅 IDE 冒烟）
GET {{addr}}/api/admin/system/scheduler/jobs?user={{username}}&queue=normal&node=cent7
Authorization: Bearer {{accessToken}}

> {%
const payload = response.body;
const jobs = payload?.data?.jobs || [];

client.test("admin jobs response returns jobs list", function() {
  client.assert(response.status === 200, "status is 200");
  client.assert(Array.isArray(jobs), "jobs is an array");
});
%}

# @manual
### 管理员获取任务详情（自动化套件只跑列表）
GET {{addr}}/api/admin/system/scheduler/jobs/{{testJobId}}
Authorization: Bearer {{accessToken}}

# @manual
### 管理员更改任务状态 (可指定用户, Kill)
POST {{addr}}/api/admin/system/scheduler/jobs/{{testJobId}}/kill
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "user": "{{username}}"
}

# @manual
### 管理员批量控制任务 (Admin only)
# jobIds 最多支持 100 个作业。
POST {{addr}}/api/admin/system/scheduler/jobs/batch-control
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "jobIds": [
    "{{testJobId}}"
  ],
  "operation": "kill"
}

# @manual
### 管理员修改作业名称 (PATCH, Admin only)
PATCH {{addr}}/api/admin/system/scheduler/jobs/{{testJobId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "renamed-job-admin",
  "user": "{{username}}"
}

# @manual
### 管理员切换作业队列 (switch, Admin only)
POST {{addr}}/api/admin/system/scheduler/jobs/{{testJobId}}/switch
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "targetQueue": "high_priority",
  "user": "{{username}}"
}
